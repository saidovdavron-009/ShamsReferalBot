BOT_TOKEN=your_bot_token_here
PORT=3000

# Option A: local/manual Postgres (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=shams_referal_bot

# Option B: hosted Postgres (e.g. Render) - overrides Option A when set
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_SSL=true
